# Copy to .env.local (git-ignored) for `pnpm dev`. On Vercel, set these in the
# project's Environment Variables instead.

# A household code a grown-up enters once per device (Grown-ups page / mobile
# Settings). Required on Vercel, where the handwriting reader (/api/handwriting)
# stays off until it is set, since reading runs on the deployment's CPU.
# Optional for local dev.
BRAINCADE_ACCESS_CODE=
