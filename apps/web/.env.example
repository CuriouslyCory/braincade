# Copy to .env.local (git-ignored) for `pnpm dev`. On Vercel, set these in the
# project's Environment Variables instead.

# Turns on the handwriting reader (/api/handwriting), which sends photos to Claude.
ANTHROPIC_API_KEY=

# A household code a grown-up enters once per device (Grown-ups page / mobile
# Settings). Required on Vercel, where the reader stays off until it is set, so
# strangers who find the URL can't spend the API key. Optional for local dev.
BRAINCADE_ACCESS_CODE=
