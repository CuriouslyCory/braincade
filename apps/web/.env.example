# Copy to .env.local (git-ignored) for `pnpm dev`. On Vercel, set these in the
# project's Environment Variables instead.

# Optional. A household code a grown-up enters once per device (Grown-ups page /
# mobile Settings). When set, only devices that know it can use the handwriting
# reader (/api/handwriting), which runs on this server's CPU.
BRAINCADE_ACCESS_CODE=
